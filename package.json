{
  "name": "@qavajs/html-formatter",
  "version": "1.4.0",
  "main": "formatter/formatter.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qavajs/html-formatter.git"
  },
  "authors": [
    "Alexandr Galichenko",
    "Alexandr Legchilov"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qavajs/html-formatter/issues"
  },
  "homepage": "https://github.com/qavajs/html-formatter#readme",
  "scripts": {
    "start": "vite --port 3000 --mode development",
    "build": "vite build --mode production",
    "postbuild": "cp dist/index.html formatter/index.html",
    "report:data": "qavajs run --config test/report.ts --profile json --no-error-exit",
    "prereport:generate": "npm run build",
    "report:generate": "qavajs run --config test/report.ts --no-error-exit",
    "serve": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "oxlint src formatter scripts test/unit",
    "lint:fix": "oxlint src formatter scripts test/unit --fix",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "QA",
    "Test Automation",
    "Cucumber"
  ],
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@epam/assets": "^6.5.4",
    "@epam/loveship": "^6.5.4",
    "@epam/uui": "^6.5.4",
    "@epam/uui-components": "^6.5.4",
    "@epam/uui-core": "^6.5.4",
    "@epam/uui-test-utils": "^6.5.4",
    "@qavajs/console-formatter": "^1.2.1",
    "@qavajs/core": "^2.18.0",
    "@qavajs/memory": "^1.11.0",
    "@qavajs/steps-playwright": "^2.18.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sass": "^1.108.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "5.1.0",
    "vitest-dom": "^0.1.1"
  }
}
