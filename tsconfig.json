{
    "compilerOptions": {
        "esModuleInterop": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "resolveJsonModule": true,
        "strict": true,
        "skipLibCheck": true,
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": [
            "vite/client",
            "vitest/globals",
            "vitest-dom/extend-expect",
            "node"
        ]
    },
    "include": ["src", "app.d.ts", "vite-env-override.d.ts"]
}
